{
  "distSpecVersion": "1.1.0",
  "storage": {
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": [
            "docker-hub/**",
            "ghcr/**",
            "erwanleboucher/**",
            "quay/**",
            "k8s-io/**"
          ],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepUntagged": {
            "pulledWithin": "2920h"
          },
          "keepTags": [
            {
              "patterns": [".*"],
              "pulledWithin": "4380h"
            }
          ]
        },
        {
          "repositories": ["**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            {
              "patterns": [".*"]
            }
          ]
        }
      ]
    },
    "rootDirectory": "/var/lib/registry"
  },
  "http": {
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [{
            "groups": ["zot-admins"],
            "actions": ["read", "create", "update", "delete"]
          }],
          "defaultPolicy": [
            "read"
          ],
          "anonymousPolicy": [
            "read"
          ]

        },
        "starforge/**": {
          "policies": [
            {
              "users": [
                "registry-push"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            },
            {
              "groups": [
                "zot-users"
              ],
              "actions": [
                "read",
                "delete"
              ]
            }
          ],
          "defaultPolicy": [
            "read"
          ]
        }
      }
    },
    "address": "0.0.0.0",
    "auth": {
      "apikey": true,
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "openid": {
        "callbackAllowOrigins": [
          "https://registry.codewalker.dev"
        ],
        "providers": {
          "oidc": {
            "name": "Authentik",
            "issuer": "https://authentik.codewalker.dev/application/o/zot/",
            "credentialsFile": "/etc/zot/openid-credentials.json",
            "scopes": [
              "openid",
              "profile",
              "email",
              "zot"
            ],
            "claimMapping": {
              "username": "preferred_username"
            }
          }
        }
      },
      "sessionKeysFile": "/etc/zot/sessionKeys.json"
    },
    "externalUrl": "https://registry.codewalker.dev",
    "port": "5000"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": [
            "https://index.docker.io",
            "https://mirror.gcr.io",
            "https://docker.io/library"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/docker-hub"
            }
          ]
        },
        {
          "urls": [
            "https://ghcr.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/ghcr"
            }
          ]
        },
        {
          "urls": [
            "https://git.erwanleboucher.dev"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/erwanleboucher"
            }
          ]
        },

        {
          "urls": [
            "https://quay.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/quay"
            }
          ]
        },
        {
          "urls": [
            "https://registry.k8s.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/k8s-io"
            }
          ]
        }

      ]
    },
    "ui": {
      "enable": true
    }
  }
}
